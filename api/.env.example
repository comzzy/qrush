# Required
CHECKOUT_ADDRESS=            # deployed QRushCheckout address on Base
CHECKOUT_DEPLOY_BLOCK=       # block the contract was deployed in (indexer start)
JWT_SECRET=

# Network
RPC_URL=
RPC_FALLBACK_URLS=
CHAIN_ID=8453

# HTTP
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787   # where this API is reachable (QR image links)
PAY_BASE_URL=                           # optional: frontend pay page base; defaults to PUBLIC_BASE_URL/pay
SIWE_DOMAIN=localhost:8787              # host the frontend signs SIWE messages for
DATABASE_PATH=./qrush.db

# Indexer
INDEXER_POLL_MS=2000
INDEXER_BATCH_BLOCKS=2000            # max getLogs range; auto-shrinks on provider limits
INDEXER_MIN_BATCH_BLOCKS=10
INDEXER_MAX_BACKOFF_MS=30000
INDEXER_CONFIRMATIONS=0

# AI price-list import (any OpenAI-compatible vision endpoint)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ERC-4337 smart wallets (any ERC-7677 paymaster / v0.7 bundler, e.g. Pimlico, Alchemy)
PAYMASTER_URL=
BUNDLER_URL=
PAYMASTER_CONTEXT=           # optional JSON passed as the ERC-7677 context, e.g. {"sponsorshipPolicyId":"sp_..."}
